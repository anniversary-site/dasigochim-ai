# ── LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=여기에_키
MODEL_NAME=gemini-3.1-flash-lite
THINKING_LEVEL=low          # low | high | off (gemini-3 계열만 유효)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── 백엔드 연동 (Dify env.BACKEND_BASE_URL / env.AGENT_TOKEN 대응) ──────
BACKEND_MODE=http           # stub = 로컬 픽스처, http = 실제 Spring 백엔드
BACKEND_BASE_URL=http://localhost:8080
AGENT_TOKEN=dev-agent-token
BACKEND_TIMEOUT_SECONDS=10

# ── stub 모드에서만 쓰는 부서 판정 정책 (http 모드에선 백엔드가 결정) ───
DEPARTMENT_CONFIDENCE_THRESHOLD=0.7
DEFAULT_DEPARTMENT_CODE=SAFETY_CENTER

# ── ⑤ 반복 발생 판정 (C-5 요청에 실어 백엔드로 보낸다) ─────────────────
CASE_WINDOW_DAYS=30
RECURRING_THRESHOLD=3

# ── 서버 ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# ── ② 객체 확인 질문 ───────────────────────────────────────────────────
# ① 의 object_confidence 가 이 값 미만이면 첫 질문을 "이 객체가 맞는지" 로 바꾼다.
OBJECT_CONFIRM_THRESHOLD=0.7

# ── ④ 문체 RAG (docs/*.pdf 재해조사의견서 → 신고서 문체) ──────────────
# 색인 만들기: python scripts/build_rag_index.py
# 색인이 없으면 ④ 는 문체 참조 없이 작성한다 (초안 생성은 막히지 않는다).
RAG_ENABLED=true
RAG_INDEX_PATH=            # 비우면 app/rag/index/style_index.json
RAG_DOCS_DIR=              # 비우면 ai-server/docs (색인 빌드 때만 쓴다)
RAG_TOP_K_PER_ROLE=2       # 역할(관찰·위험·원인·조치)마다 붙일 견본 수
RAG_MAX_CHARS_PER_EXEMPLAR=260
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ── 프롬프트 소스 · 버전 ───────────────────────────────────────────────
PROMPT_SOURCE=file          # file = app/prompts/*.yaml (git 이 진실) | langfuse
PROMPT_VERSIONS=            # 노드별 강제. 예: vision=v2,question=v1
PROMPT_CACHE_TTL_SECONDS=60 # langfuse 모드에서만 의미 있다

# ── Langfuse (PROMPT_SOURCE=langfuse 일 때) ───────────────────────────
# 비어 있으면 파일 소스로 폴백한다. 시연 중 Langfuse 가 죽어도 서비스는 산다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_PREFIX=safewhale
LANGFUSE_TRACING=true
# 트레이스가 쌓이는 환경 이름. local / demo / prod 로 갈라 Langfuse UI 에서 거른다.
LANGFUSE_TRACING_ENVIRONMENT=local
# 트레이스로 나가는 값에서 연락처·이메일 등 구조화된 개인정보를 지운다.
LANGFUSE_MASK_PII=true
